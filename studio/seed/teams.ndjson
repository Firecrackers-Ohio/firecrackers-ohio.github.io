{"_id":"team-brown","_type":"team","name":"11U Brown","slug":{"_type":"slug","current":"brown"},"cardDescription":"Building fundamentals and fostering a love for the game in young athletes.","teamPhoto":{"_type":"image","_sanityAsset":"image@file:///Users/mike/code/mannix/firecrackers/src/assets/rosters/brown/team.jpg"},"instagramUrl":"https://www.instagram.com/firecrackersoh10u/","facebookUrl":"https://www.facebook.com/profile.php?id=61577598158529","scheduleHeading":"2026 Spring/Summer Schedule","resultsHeading":"2025 Fall Results","staff":[{"_key":"coach-0","_type":"coach","name":"Gary Brown","role":"Head Coach","email":"garybrown@firecrackersohio.com","bio":[{"_key":"coach0-p0","_type":"block","style":"normal","markDefs":[],"children":[{"_key":"coach0-s0","_type":"span","text":"Gary Brown brings over 20 years of coaching experience and a lifetime of athletic excellence to the softball field. A three-sport standout in baseball, basketball, and football during his amateur career, Gary built a reputation as a competitive and driven athlete. On the baseball diamond, he competed for some of the top teams in Ohio before moving on to play collegiately at St. Petersburg College (a JUCO in Florida), where he earned All-Conference honors twice.","marks":[]}]},{"_key":"coach0-p1","_type":"block","style":"normal","markDefs":[],"children":[{"_key":"coach0-s1","_type":"span","text":"As a coach, Gary has dedicated two decades to developing amateur athletes across multiple sports. He led a competitive travel softball program for 12 seasons, most notably coaching the Firecrackers Ohio 2002 team. Following the travel program’s conclusion, Gary served as Assistant Head Coach at Dublin Coffman High School for six years.","marks":[]}]},{"_key":"coach0-p2","_type":"block","style":"normal","markDefs":[],"children":[{"_key":"coach0-s2","_type":"span","text":"Coach Brown is known for his aggressive, disciplined, and hard-working approach to the game. He emphasizes strong fundamentals, relentless effort, and a love for the game—teaching the sport the right way while fostering a competitive and team-first environment.","marks":[]}]}]},{"_key":"coach-1","_type":"coach","name":"Hannah DeLong","role":"Assistant Coach","bio":[{"_key":"coach1-p0","_type":"block","style":"normal","markDefs":[],"children":[{"_key":"coach1-s0","_type":"span","text":"A former standout player with the Ohio Hawks and graduate of Mechanicsburg High School, Hannah brings firsthand knowledge of high-level competition and a strong background in player development.","marks":[]}]}]},{"_key":"coach-2","_type":"coach","name":"Jenn Sever","role":"Assistant Coach","bio":[{"_key":"coach2-p0","_type":"block","style":"normal","markDefs":[],"children":[{"_key":"coach2-s0","_type":"span","text":"Jenn is a seasoned coach with head coaching experience at the 8U and 9U levels. Her leadership and understanding of early athlete development make her an asset to the coaching staff.","marks":[]}]}]},{"_key":"coach-3","_type":"coach","name":"Matt Foster","role":"Assistant Coach","bio":[{"_key":"coach3-p0","_type":"block","style":"normal","markDefs":[],"children":[{"_key":"coach3-s0","_type":"span","text":"Matt also brings experience as an assistant coach at the 8U and 9U levels, offering a strong foundation in team dynamics and fundamentals.","marks":[]}]}]}],"roster":[{"_key":"player-1-0","_type":"player","name":"Selah Grace Foster","number":1,"position":"OF/2B","gradYear":2033,"highSchool":"Olentangy Liberty","photo":{"_type":"image","_sanityAsset":"image@file:///Users/mike/code/mannix/firecrackers/src/assets/rosters/brown/1.jpg"}},{"_key":"player-3-1","_type":"player","name":"Chloe Biggs","number":3,"position":"OF/2B","gradYear":2034,"highSchool":"Cardington Lincoln","photo":{"_type":"image","_sanityAsset":"image@file:///Users/mike/code/mannix/firecrackers/src/assets/rosters/brown/3.jpg"}},{"_key":"player-4-2","_type":"player","name":"Macy Mullins","number":4,"position":"P/SS","gradYear":2033,"hig