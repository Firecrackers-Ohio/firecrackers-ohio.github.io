{"_id":"team-jones","_type":"team","name":"14U Jones","slug":{"_type":"slug","current":"jones"},"cardDescription":"Building well-rounded athletes through hard work and team-first mentality.","teamPhoto":{"_type":"image","_sanityAsset":"image@file:///Users/mike/code/mannix/firecrackers/src/assets/rosters/jones/team.jpg"},"instagramUrl":"https://www.instagram.com/firecrackersoh_jones13u/","facebookUrl":"https://www.facebook.com/profile.php?id=61577221302816","scheduleHeading":"2026 Spring/Summer Schedule","resultsHeading":"2025 Fall Results","staff":[{"_key":"coach-0","_type":"coach","name":"Phil Jones","role":"Head Coach","email":"philjones@firecrackersohio.com","bio":[{"_key":"coach0-p0","_type":"block","style":"normal","markDefs":[],"children":[{"_key":"coach0-s0","_type":"span","text":"With 8 years of coaching experience and in his third season leading a travel team, Coach Jones emphasizes mental toughness, softball IQ, and team culture.","marks":[]}]},{"_key":"coach0-p1","_type":"block","style":"normal","markDefs":[],"children":[{"_key":"coach0-s1","_type":"span","text":"His calm, focused leadership fosters personal growth, accountability, and selfless play.","marks":[]}]}]},{"_key":"coach-1","_type":"coach","name":"Doug Gray","role":"Associate Head Coach","email":"douggray@firecrackersohio.com","bio":[{"_key":"coach1-p0","_type":"block","style":"normal","markDefs":[],"children":[{"_key":"coach1-s0","_type":"span","text":"Now in his fourth season of travel softball, Coach Gray brings five years of coaching experience, specializing in pitching and defensive strategy.","marks":[]}]},{"_key":"coach1-p1","_type":"block","style":"normal","markDefs":[],"children":[{"_key":"coach1-s1","_type":"span","text":"His structured and technical approach enhances in-game execution and consistency.","marks":[]}]}]},{"_key":"coach-2","_type":"coach","name":"Michael Marshack","role":"Assistant Coach","bio":[{"_key":"coach2-p0","_type":"block","style":"normal","markDefs":[],"children