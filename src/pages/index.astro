---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import logoTextOutline from "../assets/logo-text-outline.svg";
import boombashFlyer from "../assets/boom-bash-flyer.png";
import { EXTERNAL_URLS } from "../config";
import { getCollection } from "astro:content";
import { ageRangeLabel } from "../lib/teams";

const teams = await getCollection("teams");
const ageRange = ageRangeLabel(teams.map(team => team.data.name));
---

<Layout
  title="Firecrackers Central Ohio Fast Pitch - Competitive Youth Softball"
  description={`Join Firecrackers Ohio for competitive fastpitch softball teams ${ageRange} in Central Ohio. Exceptional training, character development, and team excellence.`}
>
  <main class="min-h-screen">
    <div class="container mx-auto px-4 py-8">
      <!-- Header -->
      <div class="mb-12 text-center">
        <Image
          src={logoTextOutline}
          alt="FIRECRACKERS"
          class="mx-auto h-32 brightness-50 filter dark:brightness-80 dark:invert"
        />
        <h1 class="page-title">CENTRAL OHIO</h1>
      </div>

      <!-- Main Content -->
      <div class="mx-auto max-w-4xl space-y-12">
        <!-- About Section -->
        <section class="">
          <p class="body-text-xl">
            Welcome to Firecrackers Ohio, a group of fastpitch softball teams
            located in central Ohio who proudly represent the national
            Firecrackers Softball Organization. Our mission is to provide our
            athletes with exceptional training that fosters both athletic
            excellence and personal growth. We are committed to developing
            confident, respectful, and resilient young women—on and off the
            field. Our teams compete across multiple age divisions, {ageRange},
            each emphasizing fundamental skill development, competitive
            preparation, and building character through teamwork and dedication.
          </p>
        </section>

        <!-- Tryouts Section -->
        <section class="highlight-card-red">
          <h2 class="mb-4 text-3xl font-bold text-gray-900 dark:text-white">
            🥎 Interested in Joining? 🥎
          </h2>
          <p class="body-text mx-auto mb-6 max-w-2xl">
            The Firecrackers are always looking for dedicated athletes ready to
            compete, develop their skills, and join a team-first culture. Our
            rosters for the upcoming season are set, but you can reach out to
            the coach for your age group to ask about a private tryout.
          </p>
          <a href="/tryouts" class="btn-red px-6 py-3"> Contact a Coach </a>
        </section>

        <!-- Tournament Announcement Section -->
        <section class="highlight-card-gray">
          <h2 class="mb-4 text-3xl font-bold text-gray-900 dark:text-white">
            🏆 Spring Tournament Announced! 🏆
          </h2>
          <div class="mb-6">
            <a
              href={EXTERNAL_URLS.tournament}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block"
            >
              <Image
                src={boombashFlyer}
                alt="Boneyard Bash Tournament Flyer"
                class="mx-auto max-w-full rounded-lg shadow-lg transition-transform hover:scale-105"
              />
            </a>
            <div class="mt-4">
              <a
                href={EXTERNAL_URLS.tournament}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-red px-6 py-3"
              >
                Click Here to Register!
              </a>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>
