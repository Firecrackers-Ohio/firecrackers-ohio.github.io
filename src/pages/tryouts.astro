---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import logoTextOutline from "../assets/logo-text-outline.svg";
import {
  ageGroupLabel,
  ageRangeLabel,
  getTeamsInDisplayOrder,
} from "../lib/teams";

/**
 * Between seasons this page is a general "get in touch" page rather than a
 * listing of tryout dates. It's built from the teams collection, so a team that
 * stops running disappears from here automatically instead of being left behind
 * advertising a coach who has moved on.
 *
 * Contact details come from each team's head coach — the first entry in its
 * staff list — plus the phone number and birth year range on the team itself.
 */
const teams = await getTeamsInDisplayOrder();

const ageGroups = teams.map(team => {
  const headCoach = team.data.staff[0];
  const firstName = headCoach.name.trim().split(/\s+/)[0];
  const surname = headCoach.name.trim().split(/\s+/).at(-1) ?? headCoach.name;

  return {
    slug: team.id,
    age: ageGroupLabel(team.data.name) ?? team.data.name,
    coachSurname: surname.toUpperCase(),
    coachFirstName: firstName,
    birthYears: team.data.birthYears,
    phone: team.data.tryoutPhone,
    email: headCoach.email,
  };
});

const ageRange = ageRangeLabel(teams.map(team => team.data.name));
---

<Layout
  title="Tryouts | Firecrackers Central Ohio"
  description={`Interested in joining Firecrackers Central Ohio? Contact the coach for your age group ${ageRange} to ask about tryout opportunities.`}
>
  <div class="container mx-auto px-4 py-8">
    <!-- Header -->
    <div class="mb-12 text-center">
      <Image
        src={logoTextOutline}
        alt="FIRECRACKERS"
        class="mx-auto h-32 brightness-50 filter dark:brightness-80 dark:invert"
      />
      <h1 class="page-title">TRYOUTS</h1>
      <p class="body-text-xl mx-auto max-w-2xl">
        Our rosters for the upcoming season are now set! Follow our social media
        pages to hear about future tryout opportunities. Interested players can
        also reach out to the coach of their age group to ask about a private
        tryout.
      </p>
    </div>

    <!-- Age Groups Grid -->
    <div class="mx-auto max-w-4xl">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
        {
          ageGroups.map(group => (
            <div class="rounded-lg bg-gray-50 p-8 shadow-lg dark:bg-gray-800">
              <div class="mb-2 border-b-2 border-gray-300 pb-4 dark:border-gray-600">
                <h3 class="text-red text-3xl font-bold">
                  <a
                    href={`/teams/${group.slug}`}
                    class="transition-all hover:text-red-400 hover:underline dark:text-gray-400"
                  >
                    {group.age} - {group.coachSurname}
                  </a>
                </h3>
                {group.birthYears && (
                  <p class="mt-2 text-sm font-medium tracking-wide text-gray-600 dark:text-gray-400">
                    {group.birthYears}
                  </p>
                )}
              </div>

              <div class="space-y-2">
                <p class="text-lg font-medium text-gray-900 dark:text-white">
                  Contact Coach {group.coachFirstName}
                </p>
                <p class="text-lg text-gray-900 dark:text-white">
                  {group.phone}
                  {group.phone && group.email && <br />}
                  {group.email && (
                    <a
                      href={`mailto:${group.email}`}
                      class="text-link dark:text-red-400"
                    >
                      {group.email}
                    </a>
                  )}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Layout>
