---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";

import Layout from "../layouts/Layout.astro";
import RichText from "../components/RichText.astro";
import logoTextOutline from "../assets/logo-text-outline.svg";

// Content for this page lives in Sanity Studio, not in this file.
// Edit it at https://firecrackersohio.sanity.studio → "About page".
const about = await getEntry("about", "about");

if (!about) {
  throw new Error(
    "No About page content found in Sanity. Either the `aboutPage` document " +
      "hasn't been created and published yet, or the Sanity project ID in " +
      "src/lib/sanity/client.ts is still a placeholder. To load the starting " +
      "content, run `npm run seed` inside the studio/ folder."
  );
}

const { pageTitle, sections } = about.data;
---

<Layout
  title="About Us | Firecrackers Central Ohio"
  description="Learn about Firecrackers Central Ohio's mission, culture, and commitment to developing confident, skilled young athletes through fastpitch softball."
>
  <div class="container mx-auto px-4 py-8">
    <!-- Header -->
    <div class="mb-12 text-center">
      <Image
        src={logoTextOutline}
        alt="FIRECRACKERS"
        class="mx-auto h-32 brightness-50 filter dark:brightness-80 dark:invert"
      />
      <h1 class="page-title">{pageTitle.toUpperCase()}</h1>
    </div>

    <!-- Main Content -->
    <div class="mx-auto max-w-4xl space-y-12">
      {
        /* Layout alternates by position — plain, boxed, plain, boxed — rather
           than being chosen per section in the CMS. Editors control the words
           and the order; the presentation is decided here. */
        sections.map((section, i) =>
          i % 2 === 1 ? (
            <section class="card-lg">
              <h2 class="section-heading text-center">{section.heading}</h2>
              <RichText value={section.body} />
            </section>
          ) : (
            <section class="text-center">
              <h2 class="section-heading">{section.heading}</h2>
              <RichText value={section.body} size="large" />
            </section>
          )
        )
      }
    </div>
  </div>
</Layout>
