---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import logoTextOutline from "../assets/logo-text-outline.svg";
import { ageRangeLabel, getTeamsInDisplayOrder } from "../lib/teams";

// Driven by the teams collection, so adding or removing a team in Sanity
// updates this page without a code change.
const teams = await getTeamsInDisplayOrder();
const ageRange = ageRangeLabel(teams.map(team => team.data.name));
---

<Layout
  title="Our Teams | Firecrackers Central Ohio"
  description={`Meet the Firecrackers Ohio teams competing ${ageRange}. Learn about our coaching staff, training philosophy, and team culture.`}
>
  <div class="container mx-auto px-4 py-8">
    <!-- Header -->
    <div class="mb-12 text-center">
      <Image
        src={logoTextOutline}
        alt="FIRECRACKERS"
        class="mx-auto h-32 brightness-50 filter dark:brightness-80 dark:invert"
      />
      <h1 class="page-title">OUR TEAMS</h1>
      <p class="body-text-xl mx-auto max-w-2xl">
        Meet the Firecrackers Ohio teams competing at various age levels. Click
        on any team to learn more about their coaching staff, training
        structure, and philosophy.
      </p>
    </div>

    <!-- Teams Grid -->
    <div class="card-container mx-auto max-w-4xl">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          teams.map(team => (
            <a href={`/teams/${team.id}`} class="group team-card">
              <h2 class="team-card-title group-hover:text-red">
                {team.data.name}
              </h2>
              <p class="team-card-description">{team.data.cardDescription}</p>
              <div class="team-card-link group-hover:underline">
                Learn more →
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</Layout>
